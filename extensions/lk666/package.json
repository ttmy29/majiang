{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "lk666",
    "version": "1.0.0",
    "author": "Cocos Creator",
    "editor": ">=3.8.8",
    "main": "./dist/main.js",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc"
    },
    "title": "i18n:lk666.title",
    "description": "i18n:lk666.description",
    "panels": {
        "default": {
            "title": "i18n:lk666.panel_title",
            "type": "dockable",
            "main": "./dist/panel.js",
            "size": {
                "width": 860,
                "height": 760,
                "min-width": 620,
                "min-height": 560
            }
        }
    },
    "contributions": {
        "builder": "./dist/builder.js",
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "get-config": {
                "methods": [
                    "getConfig"
                ]
            },
            "save-config": {
                "methods": [
                    "saveConfig"
                ]
            }
        },
        "menu": [
            {
                "path": "i18n:menu.extension",
                "label": "i18n:lk666.menu.open",
                "message": "open-panel"
            }
        ]
    },
    "dependencies": {
        "fs-extra": "^10.0.0",
        "javascript-obfuscator": "^0.28.0"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.1",
        "@types/fs-extra": "^5.0.4",
        "@types/node": "^18.17.1",
        "typescript": "^5.8.2"
    }
}
